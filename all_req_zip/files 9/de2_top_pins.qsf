# =============================================================================
# de2_top_pins.qsf
# -----------------------------------------------------------------------------
# Pin assignments for de2_top.v on the Terasic DE2-115 (Cyclone IV EP4CE115).
#
# SOURCE / CONFIDENCE NOTE: these pin locations are cross-confirmed from
# multiple independently published DE2-115 course materials citing the
# official Terasic "DE2-115.qsf" pin file (used unmodified across several
# university lab courses), NOT verified by directly running Quartus here.
# The I/O standard (2.5V) matches what your own synthesis log already
# auto-selected for these exact signals in Session 11/12
# ("I/O standards used: 2.5 V"), which is a good real-world consistency
# check. Still, before final programming: open Quartus's Pin Planner and
# visually confirm these against your board's silkscreen labels /
# official DE2_115_User_manual.pdf, since a wrong pin assignment is cheap
# to get wrong and this file was not tested by actually running Quartus.
#
# HOW TO USE:
# Import via Assignments -> Import Assignments in Quartus, pointing at
# this file -- OR open Assignments -> Pin Planner and enter these
# manually against the corresponding port names. Port names below must
# exactly match de2_top.v's port list (CLOCK_50, KEY[1:0], LEDG[1:0]) --
# confirmed they do, as of the current de2_top.v.
# =============================================================================

set_location_assignment PIN_Y2   -to CLOCK_50
set_location_assignment PIN_M23  -to KEY[0]
set_location_assignment PIN_M21  -to KEY[1]
set_location_assignment PIN_E21  -to LEDG[0]
set_location_assignment PIN_E22  -to LEDG[1]

set_instance_assignment -name IO_STANDARD "2.5 V" -to CLOCK_50
set_instance_assignment -name IO_STANDARD "2.5 V" -to KEY[0]
set_instance_assignment -name IO_STANDARD "2.5 V" -to KEY[1]
set_instance_assignment -name IO_STANDARD "2.5 V" -to LEDG[0]
set_instance_assignment -name IO_STANDARD "2.5 V" -to LEDG[1]
